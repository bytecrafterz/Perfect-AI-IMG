# Copy to .env and fill in.  Nothing here has a working default on purpose:
# a missing key produces a clearly degraded mode that announces itself, never
# a silent fallback that looks like it is working.
#
#   cp .env.example .env

# --- who ---------------------------------------------------------------------
OWNER_NAME=Nayane

# --- the address -------------------------------------------------------------
# A free subdomain works fine while she is the only user. A real domain costs
# ~$10-12/year and is the only optional expense in the whole project - worth
# it the moment she shows this to a client of her own, because the address is
# her brand. Caddy issues the certificate either way, free and automatically.
DOMAIN=nayane-estudio.duckdns.org

# --- security ----------------------------------------------------------------
# Generate both:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SECRET_KEY signs the session cookie. If it is unset an ephemeral one is
# generated, which means every restart logs her out - visible and annoying,
# and far better than a predictable key that quietly signs forgeable cookies.
SECRET_KEY=

# ACCESS_TOKEN is the private link she is sent once:
#     https://your-domain/e/<ACCESS_TOKEN>
# If it is unset, ANYONE with the address gets in. Acceptable on a laptop,
# unacceptable the moment this is reachable from the internet.
ACCESS_TOKEN=

SESSION_DAYS=365

# --- language models ---------------------------------------------------------
# Without this the photo analysis falls back to pixel heuristics and the
# visual judge does not run at all. The app still works; it is just blinder.
ANTHROPIC_API_KEY=
ANALYSER_MODEL=claude-opus-5
JUDGE_MODEL=claude-haiku-4-5

# --- image providers ---------------------------------------------------------
# With neither set, the local mock generator is used: it costs nothing, runs
# the whole pipeline end to end, and produces placeholder cards rather than
# photographs. Good for demonstrating the system, useless for delivering work.
FAL_API_KEY=
REPLICATE_API_TOKEN=

# --- batch shape -------------------------------------------------------------
PREVIEW_COUNT=6
PREVIEW_WIDTH=512
PREVIEW_HEIGHT=640
FINAL_WIDTH=1024
FINAL_HEIGHT=1280

# --- concurrency -------------------------------------------------------------
# Generation is I/O bound (waiting on a provider) so it fans out wide.
# CV is CPU bound on a 4-core box, so it is capped separately to stop it
# starving the event loop and blowing the latency budget.
GENERATION_CONCURRENCY=6
CV_CONCURRENCY=2

# --- limits ------------------------------------------------------------------
MAX_UPLOAD_MB=30
MAX_REPAIR_ATTEMPTS=1
MAX_REFILL_ROUNDS=2

# --- paths -------------------------------------------------------------------
# Windows Server (nginx deployment - see deploy/windows/):
DATA_DIR=C:/estudio/data
CATALOG_DIR=C:/estudio/catalog
#
# Docker on Linux (the docker-compose path) uses these instead:
#   DATA_DIR=/srv/data
#   CATALOG_DIR=/srv/catalog
#
# Forward slashes work on Windows and avoid the escaping traps that backslashes
# cause in .env files, where \n and \t are the obvious hazards but \e and \U
# bite just as hard.

# DEBUG=true only on a laptop.
DEBUG=
